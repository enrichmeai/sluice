[sqlfluff]
dialect = bigquery
templater = jinja
# Rules that depend on house style are left out; the point of this check is "parses as
# BigQuery SQL and has no structural violations", not formatting taste.
exclude_rules = LT01,LT02,LT05,LT09,LT12,LT13,LT14,ST06,AM04,RF04,CV06

[sqlfluff:templater:jinja]
# sqlfluff's Jinja templater ships dbt's builtins (ref, source, config, var, this,
# is_incremental, target) when this is on, so no profile, warehouse or dbt templater is needed.
# Overriding them here broke config(materialized=...) (found 2026-11-03), so they are not.
apply_dbt_builtins = true
